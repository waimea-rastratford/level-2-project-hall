{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Bookings</h2>

    <section id="bookings">

        {% for date in dates %}

            {% for booking in bookings %}

             {% if date != booking.date %}
                    <div class="day">

                        <header>
                            <h3>{{ date }}</h3>
                           {# `  <a href="/booking/<date>"></a> #}
                        </header>

                </div>

                {%else%}
                    <div class="booked_day">

                        <header>
                            <h3>{{ date }}</h3>
                        </header>
                
                    </div>
                {% endif %}


            {% endfor %}

        {% endfor %}

    </section>

{% endblock %}

