{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Bookings</h2>

    <section id="bookings">

        {% for date in dates %}

            {% set booked = namespace(value=false) %}


            {% for booking in bookings %}
                {% if date == booking['date'] %}
                    {% set booked.value = true %}
                {% endif %}
            {% endfor %} 

            {% if booked.value == true %}
                <div class="booked_day">
                    <a href="/booking/{{ date }}">
                        <header>
                            <h3>{{ date }}</h3>
                        </header>
                    </a>
                </div>
                {% else  %}

                    <div class="day">
                        <a href="/booking/{{ date }}">
                            <header>
                                <h3>{{ date }}</h3>
                            </header>
                        </a>
                    </div>

            {% endif%}
            
        {% endfor %}

    </section>

{% endblock %}

