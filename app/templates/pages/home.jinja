  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Bookings</h2>

    <section id="bookings">

        {% for date in dates %}

            <div class="day">

                <header>
                    <h3>{{ date }}</h3>
                </header>


                {% for booking in bookings %}

                    {% if date == booking.date %}

                        {{ booking.event }}

                    {% endif %}

                {% endfor %}

            </div>

        {% endfor %}

    </section>

{% endblock %}

