{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Bookings</h2>

    <section id="bookings">

        {% for date in dates %}


            {% set booked = namespace(value=false) %}


            {% for booking in bookings %}

                {% if date == bookings.date %}
                    {% set booked.value = true %}
                {% endif%}

            {% endfor %}    

            {% if booked.value == false %}
                <div class="day">

                        <header>
                            <h3>{{ date }}</h3>
                             <a href="/booking/<date>"></a>
                        </header>

            {% elif booked.value == true %}

            <div class="booked_day">

                        <header>
                            <h3>{{ date }}</h3>
                             <a href="/booking/<date>"></a>
                        </header>


            {% endif%}
            
        {% endfor %}

    </section>

{% endblock %}

