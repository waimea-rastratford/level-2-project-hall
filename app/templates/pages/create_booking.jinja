{% extends 'pages/_base.jinja' %}


{% block content %}
    
    
    <h2>Create Booking</h2>

  <div id="booking_form">
      <form method="post" action="/creature/new">
      
        <label>
          Name 
          <input type="text" name="name" required>
        </label>

        <label>
          Species
          <input type="text" name="species" required>
        </label>
      
      <button>Add Creature</button>
      </form>
  </div>




{% endblock %}

