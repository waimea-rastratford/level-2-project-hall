  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    
    {% if booking.name %}
      <div class="booking_details">

        <h2>Booking for {{ booking.name }} </h2>
        <h3>Phone Number: {{ booking.phone_number }}</h3>
        <h3>Event: {{ booking.event }}</h3>

      </div>
    {% else %}
        
      <h2> Booking Empty</h2>
    {% endif %}




{% endblock %}

